;; defsrc is still necessary
(defcfg
  process-unmapped-keys true
  movemouse-inherit-accel-state yes
  movemouse-smooth-diagonals yes
)


(defsrc
  esc   1    2    3    4    5    6    7    8    9    0    -    =     bspc    ins
  tab   q    w    e    r    t    y    u    i    o    p    [    ]     \       del
  caps  a    s    d    f    g    h    j    k    l    ;    '     ret          pgup
  lsft  z    x    c    v    b    n    m    ,    .    /     rsft     up       pgdn
  lctl  lmet lalt           spc               ralt  rctl       left down right
)

(defvar
  tap-time 200
  hold-time 250
  hold-time-slow 350
)

(defalias
  ;; REMAPS
  cape (tap-hold $tap-time $hold-time esc (layer-toggle arrows))
  ent (tap-hold $tap-time $hold-time ' enter)
  [ (tap-hold $tap-time $hold-time [ bspc)
  hbspc (macro-repeat 90 C-bspc)
  mbspc (tap-hold $tap-time $hold-time bspc @hbspc)
  uns (multi S--)

  ;; MOUESE
  mwu (mwheel-up 50 120)
  mwd (mwheel-down 50 120)
  mwl (mwheel-left 50 120)
  mwr (mwheel-right 50 120)

  msu (movemouse-up 1 1)
  msl (movemouse-left 1 1)
  msd (movemouse-down 1 1)
  msr (movemouse-right 1 1)
  
  slw (movemouse-speed 50)

  ;; MACROS
  enmo (macro S-RS-(20 c))
  enmog (macro S-RS-(20 g))
  ;; vup (macro-repeat A-up)
  ;; vdw (macro-repeat A-down)
  spo (macro A-S-C-p M-d M-d A-S-C-s)
  mflo (macro f8 15 a)

  ;; HOME ROW MODS
  a (tap-hold $tap-time $hold-time a lmet)
  s (tap-hold $tap-time $hold-time s lsft)
  d (tap-hold $tap-time $hold-time d lctl)
  f (tap-hold $tap-time $hold-time-slow f lalt)

  j (tap-hold $tap-time $hold-time-slow j ralt)
  k (tap-hold $tap-time $hold-time k rctl)
  l (tap-hold $tap-time $hold-time l rsft)
  ; (tap-hold $tap-time $hold-time ; rmet)

  c (tap-hold $tap-time $hold-time c C-c)
  v (tap-hold $tap-time $hold-time v C-v)

  obr (tap-hold $tap-time $hold-time [ S-[)
  cbr (tap-hold $tap-time $hold-time ] S-])
  fsl (tap-hold $tap-time $hold-time \ S-\)


  ap (tap-hold $tap-time $hold-time ' S-')

  co (tap-hold $tap-time $hold-time , S-,)
  fu (tap-hold $tap-time $hold-time . S-.)
  bsl (tap-hold $tap-time $hold-time / S-/)

  ;; Media Controls
  nex M-right
  prv M-left
  vup M-up
  vdw M-down
  pp M-S-p

  ;; MULTI ACTIONS
  mov (multi (layer-switch mouse) f8)
  movh (multi (layer-switch mouse) f14)
  1shot (multi n (layer-switch base))
  capb (multi esc (layer-switch base))
  muev (multi f7 mute)

  ;; LAYERS 
  bse (layer-switch base)
  gam (layer-switch gaming)
  tmos (layer-toggle mouse)
  mos (layer-switch mouse)
  arr (layer-toggle arrows)
  num (layer-toggle num)
  wm (layer-toggle wm)
  moa (layer-toggle media)

  mutom (tap-hold $tap-time $hold-time f7 @tmos)
  mntoh (tap-hold $tap-time $hold-time @mflo @mov)
  lam (tap-hold $tap-time $hold-time f3 @moa)
  fwm (tap-hold $tap-time $hold-time f9 @num)
  spc (tap-hold $tap-time $hold-time spc @wm)
)

(deflayer base
  XX     XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   f16     @gam
  _      _    _    _    _    _    _    _    _    _    _    @obr @cbr @fsl    del
  @cape  @a   @s   @d   @f   _    _    @j   @k   @l   @;   @ap  _            pgup
  @lam   _    _    @c   @v   _    _    _    @co  @fu  @bsl   @mbspc   _      pgdn
  @mntoh     @mutom    @fwm           @spc           @num    _     _  _  _
)

(deflayer arrows
  XX    XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX     XX     @gam
  _     _    _    _    _    _    _    _    _    _    _    _    _      _      del
  _     @a   @s   @d   @f   _    left down up  right _    _    _             pgup
  @lam  _    _    _    _    _    _    _    _   _     _   bspc        XX      pgdn
  _    f7   @fwm              @spc          @num     _            XX XX XX
)

(deflayer num
  XX     XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX     @capb  @gam
  _      _    _    _    @uns A-M-C-t   _    7    8    9    _    _    _    _   del
  @cape  @a   @s   @d   .    `         -    4    5    6    +    =    _        pgup
  @lam   0    _    ,    S-\  \         @uns 1    2    3    0     bspc XX      pgdn
  @capb       f7    @fwm          @spc              _    _         XX XX XX
)

(deflayer wm
  XX     XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX     @capb                          @gam
  _      M-c       A-S-C-w  A-S-C-e  A-S-r   A-S-C-t  A-S-e      _    _    _     XX  @[   _    _      del
  @cape  _         A-S-C-t     M-d      _       A-4      A-S-C-g    _    _    A-S-C-;   _    _    _   pgup
  @lam   _         _        A-S-C-d  _       A-S-C-b  _          _    _    _    _    bspc    XX       pgdn
  @capb       f7    @fwm           @spc                    _    _                         XX XX XX
)

(deflayer gaming
  esc   1    2    3    4    5    6    7    8    9    0    -    =     XX    @bse
  tab   q    w    e    r    t    y    u    i    o    p    [    ]     \     del
  lctl  a    s    d    f    g    h    j    k    l    ;    '     ret        pgup
  lsft  z    x    c    v    b    n    m    ,    .    /     bspc   _        pgdn
  f3    f7  lalt           spc               ralt    rctl       _ _ _
)

(deflayer mouse
  XX    XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   _  @capb    @bse
  _     _    _    @mwu _    _    _    _    _    _    _    @[   _    _      del
  @capb @slw @mwl @mwd @mwr _    @msl @msd @msu @msr  _    _    _          pgup
  @lam  _    _    _    _    _    mltp mmtp mrtp _    _    bspc   XX        pgdn
  @capb      f7    @fwm           _              _     _      XX XX XX
)

(deflayer media
  XX    XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX     ins
  _     _    f23  @vup f21  _    prev vold volu next pp   _    _    _      del
  @cape _    @prv @vdw @nex f20  @prv @vdw @vup @nex f23  _    _           pgup
  @lam  _    _    _    _    _    _    mute  _    _    _    bspc       XX   pgdn
  _       f7    @fwm           @pp              _        _         XX XX XX
)
